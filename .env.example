# =============================================================================
# DB-ChatBot — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="DB ChatBot"
APP_VERSION="1.0.0"
APP_DESCRIPTION="A production-ready Database Chatbot API built with FastAPI."
DEBUG=False
ENVIRONMENT=development          # development | staging | production


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080


# -----------------------------------------------------------------------------
# Database — PostgreSQL
# asyncpg driver is used at runtime; psycopg2 is used by Alembic migrations.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_password
POSTGRES_DB=chatbot_db

# Constructed URLs (the app builds these from the parts above,
# but you can override them directly here if needed)
DATABASE_URL=postgresql+asyncpg://chatbot_user:chatbot_password@localhost:5432/chatbot_db
DATABASE_URL_SYNC=postgresql+psycopg2://chatbot_user:chatbot_password@localhost:5432/chatbot_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30              # seconds to wait for a connection
DB_POOL_RECYCLE=1800            # recycle connections every 30 minutes
DB_ECHO=False                   # set True to log every SQL statement (dev only)


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                 # json | text


# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# AI / LLM (NL-to-SQL)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT=30
SCHEMA_CACHE_TTL_SECONDS=300
MAX_QUERY_RESULTS=500
MAX_SCHEMA_TABLES=100
