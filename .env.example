APP_NAME="DB ChatBot"
APP_VERSION="1.0.0"
APP_DESCRIPTION="A production-ready Database Chatbot API built with FastAPI."
DEBUG=False
ENVIRONMENT=development

API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_password
POSTGRES_DB=chatbot_db

DATABASE_URL=postgresql+asyncpg://chatbot_user:chatbot_password@localhost:5432/chatbot_db
DATABASE_URL_SYNC=postgresql+psycopg2://chatbot_user:chatbot_password@localhost:5432/chatbot_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO
LOG_FORMAT=json

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT=30
SCHEMA_CACHE_TTL_SECONDS=300
MAX_QUERY_RESULTS=500
MAX_SCHEMA_TABLES=100

CACHE_ENABLED=True
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_CANDIDATES=1000
CACHE_PREVIEW_ROWS=10